#. Plugin Name of the plugin
#: yourmark-image-sizes.php
msgid "YourMark image sizes"
msgstr "YourMark afbeeldingsformaten"

#. Description of the plugin
#: yourmark-image-sizes.php
msgid "Makes each image size the first time something uses it, in the format chosen under Settings > Media."
msgstr "Maakt elk afbeeldingsformaat pas als iets het gebruikt, in het bestandstype dat onder Instellingen > Media is gekozen."

#. translators: %s: WebP or AVIF
#: src/Admin.php:89
#, php-format
msgid "Convert to %s"
msgstr "Omzetten naar %s"

#: src/Admin.php:90
msgid "Stores uploads from before this setting in the chosen format. The old file stays, so existing links keep working."
msgstr "Slaat uploads van vóór deze instelling op in het gekozen bestandstype. Het oude bestand blijft staan, dus bestaande links blijven werken."

#: src/Admin.php:91
msgid "Convert originals"
msgstr "Originelen omzetten"

#: src/Admin.php:96
msgid "Warm pages"
msgstr "Pagina’s opwarmen"

#: src/Admin.php:97
msgid "Makes the images every page in the sitemap shows, so no visitor waits for one."
msgstr "Maakt de afbeeldingen die elke pagina in de sitemap toont, zodat geen bezoeker erop hoeft te wachten."

#: src/Admin.php:98
msgid "Warm all pages"
msgstr "Alle pagina’s opwarmen"

#: src/Admin.php:102
msgid "Clean up sizes"
msgstr "Formaten opruimen"

#: src/Admin.php:104
msgid "Count size files"
msgstr "Formaatbestanden tellen"

#: src/Admin.php:166
msgid "Sizes"
msgstr "Formaten"

#: src/Admin.php:221
msgid "Unknown task."
msgstr "Onbekende taak."

#: src/Admin.php:266
msgid "Not an image."
msgstr "Dit is geen afbeelding."

#: src/Admin.php:475
msgid "You are not allowed to do this."
msgstr "Je hebt geen toestemming om dit te doen."

#. translators: %s: WebP or AVIF
#: src/Admin.php:436
#, php-format
msgid "Generate %s"
msgstr "%s genereren"

#: src/Admin.php:497
msgid "Clear the page cache afterwards: this server does not pass missing images to WordPress."
msgstr "Leeg daarna de paginacache: deze server stuurt ontbrekende afbeeldingen niet door naar WordPress."

#: src/Admin.php:500
msgid "Warming pages: {done} of {total}"
msgstr "Pagina’s opwarmen: {done} van {total}"

#: src/Admin.php:501
msgid "Done. Made {made} sizes across {total} pages."
msgstr "Klaar. {made} formaten gemaakt voor {total} pagina’s."

#: src/Admin.php:503
msgid "No pages found in the sitemap."
msgstr "Geen pagina’s gevonden in de sitemap."

#: src/Admin.php:504
msgid "Converting: {done} of {total} images"
msgstr "Omzetten: {done} van {total} afbeeldingen"

#: src/Admin.php:512
msgid "Counting: {done} of {total} images"
msgstr "Tellen: {done} van {total} afbeeldingen"

#: src/Admin.php:513
msgid "Found {files} size files ({size})."
msgstr "{files} formaatbestanden gevonden ({size})."

#: src/Admin.php:515
msgid "Delete {files} files"
msgstr "{files} bestanden verwijderen"

#: src/Admin.php:517
msgid "Cancel"
msgstr "Annuleren"

#: src/Admin.php:518
msgid "Deleting: {done} of {total} images"
msgstr "Verwijderen: {done} van {total} afbeeldingen"

#: src/Admin.php:522
msgid "Nothing was deleted."
msgstr "Er is niets verwijderd."

#: src/Admin.php:525
msgid "Done. Made {made} sizes."
msgstr "Klaar. {made} formaten gemaakt."

#: src/Admin.php:526
msgid "Done. Converted the original and made {made} sizes."
msgstr "Klaar. Origineel omgezet en {made} formaten gemaakt."

#: src/Admin.php:527
msgid "Something went wrong: {message}"
msgstr "Er ging iets mis: {message}"

#: src/Settings.php:45
msgid "Images"
msgstr "Afbeeldingen"

#: src/Settings.php:46
#: src/Settings.php:75
msgid "File format"
msgstr "Bestandstype"

#: src/Settings.php:49
msgid "Maintenance"
msgstr "Onderhoud"

#: src/Settings.php:59
msgid "Image sizes are made the first time a page, the editor or the media library uses them, not at upload. Sizes nobody uses are never made."
msgstr "Afbeeldingsformaten worden gemaakt zodra een pagina, de editor of de mediabibliotheek ze voor het eerst gebruikt, niet bij het uploaden. Formaten die niemand gebruikt, worden nooit gemaakt."

#: src/Settings.php:70
msgid "As uploaded"
msgstr "Zoals geüpload"

#: src/Settings.php:70
msgid "JPEG and PNG stay JPEG and PNG."
msgstr "JPEG en PNG blijven JPEG en PNG."

#: src/Settings.php:71
msgid "WebP"
msgstr "WebP"

#: src/Settings.php:71
msgid "Works in every browser. The safe choice."
msgstr "Werkt in elke browser. De veilige keuze."

#: src/Settings.php:72
msgid "AVIF"
msgstr "AVIF"

#: src/Settings.php:72
msgid "About a quarter smaller than WebP at the same quality, but twice as slow to make."
msgstr "Ongeveer een kwart kleiner dan WebP bij dezelfde kwaliteit, maar twee keer zo traag om te maken."

#: src/Settings.php:88
msgid "Not supported by this server."
msgstr "Niet ondersteund door deze server."

#: src/Settings.php:92
msgid "Applies to new uploads and to every size made from now on. Older uploads can be converted below."
msgstr "Geldt voor nieuwe uploads en voor elk formaat dat vanaf nu wordt gemaakt. Oudere uploads kun je hieronder omzetten."

#: src/Admin.php:275
msgid "This image has no such size."
msgstr "Deze afbeelding heeft dat formaat niet."

#: src/Admin.php:376
msgid "On disk"
msgstr "Op schijf"

#. translators: 1: size name, 2: dimensions
#: src/Admin.php:382
#, php-format
msgid "Make %1$s (%2$s) now"
msgstr "%1$s (%2$s) nu maken"

#: src/Admin.php:383
msgid "Make now"
msgstr "Nu maken"

#. translators: %d: number of sizes
#: src/Admin.php:397
#, php-format
msgid "Its %d size is on disk."
msgid_plural "All %d sizes are on disk."
msgstr[0] "Het enige formaat staat op schijf."
msgstr[1] "Alle %d formaten staan op schijf."

#. translators: 1: sizes on disk, 2: all sizes
#: src/Admin.php:399
msgid "The rest is made the first time something uses it."
msgstr "De rest wordt gemaakt zodra iets het voor het eerst gebruikt."

#. translators: 1: current format, 2: WebP or AVIF
#: src/Admin.php:407
#, php-format
msgid "The original is %1$s. The button below converts it to %2$s and makes every size."
msgstr "Het origineel is %1$s. De knop hieronder zet het om naar %2$s en maakt alle formaten."

#: src/Admin.php:441
msgid "Make missing sizes"
msgstr "Ontbrekende formaten maken"

#: src/Admin.php:454
msgid "Thumbnail"
msgstr "Miniatuur"

#: src/Admin.php:455
msgid "Medium"
msgstr "Gemiddeld"

#: src/Admin.php:456
msgid "Medium large"
msgstr "Middelgroot"

#: src/Admin.php:457
msgid "Large"
msgstr "Groot"

#: src/Admin.php:502
msgid "Done. All {total} pages already had every image they show."
msgstr "Klaar. Alle {total} pagina’s hadden al elke afbeelding die ze tonen."

#: src/Admin.php:505
msgid "Done. Converted {converted} originals to {format}."
msgstr "Klaar. {converted} originelen omgezet naar {format}."

#: src/Admin.php:506
msgid "Done. Nothing needed converting."
msgstr "Klaar. Er hoefde niets omgezet te worden."

#: src/Admin.php:507
msgid "{count} were already {format}."
msgstr "{count} waren al {format}."

#: src/Admin.php:508
msgid "The site icon stays PNG: iOS ignores any other format."
msgstr "Het site-icoon blijft PNG: iOS negeert elk ander type."

#: src/Admin.php:510
msgid "{count} are GIF, SVG or another format that is never converted."
msgstr "{count} zijn GIF, SVG of een ander type dat nooit wordt omgezet."

#: src/Admin.php:511
msgid "{count} could not be converted; the server log has the reason."
msgstr "{count} konden niet worden omgezet; de reden staat in de serverlog."

#: src/Admin.php:519
msgid "Done. Deleted {files} files and freed {size}. Sizes come back as pages use them."
msgstr "Klaar. {files} bestanden verwijderd, {size} vrijgemaakt. Formaten komen terug zodra pagina’s ze gebruiken."

#: src/Admin.php:521
msgid "There are no size files to clean up."
msgstr "Er zijn geen formaatbestanden om op te ruimen."

#: src/Admin.php:523
msgid "Making…"
msgstr "Bezig met maken…"

#: src/Admin.php:524
msgid "Done. The size is on disk."
msgstr "Klaar. Het formaat staat op schijf."

#: src/Health.php:63
msgid "Image sizes"
msgstr "Afbeeldingsformaten"

#: src/Health.php:80
msgid "New image sizes get their final URL straight away"
msgstr "Nieuwe afbeeldingsformaten krijgen meteen hun definitieve URL"

#: src/Health.php:81
msgid "New image sizes are served through PHP the first time"
msgstr "Nieuwe afbeeldingsformaten gaan de eerste keer via PHP"

#: src/Health.php:84
msgid "Performance"
msgstr "Prestaties"

#: src/Health.php:89
msgid "The web server passes a request for a missing image to WordPress, which makes the size and leaves it on disk for the server to serve from then on."
msgstr "De webserver stuurt een verzoek voor een ontbrekende afbeelding door naar WordPress. Dat maakt het formaat en zet het op schijf, waarna de server het voortaan zelf serveert."

#: src/Health.php:90
msgid "The web server answers a request for a missing image itself, so pages point a new size at PHP until it exists. That works on every server, but each new size takes a detour once. The server rule in the image sizes plugin’s README removes the detour."
msgstr "De webserver beantwoordt een verzoek voor een ontbrekende afbeelding zelf, dus pagina’s laten een nieuw formaat via PHP lopen tot het bestaat. Dat werkt op elke server, maar elk nieuw formaat maakt één keer een omweg. De serverregel in de README van de plugin haalt die omweg weg."

#. translators: 1: sizes on disk, 2: all sizes
#: src/Admin.php:399
#, php-format
msgid "%1$d of %2$d sizes is on disk."
msgid_plural "%1$d of %2$d sizes are on disk."
msgstr[0] "%1$d van de %2$d formaten staat op schijf."
msgstr[1] "%1$d van de %2$d formaten staan op schijf."

#: src/Admin.php:514
msgid "Found 1 size file ({size})."
msgstr "1 formaatbestand gevonden ({size})."

#: src/Admin.php:516
msgid "Delete 1 file"
msgstr "1 bestand verwijderen"

#: src/Admin.php:520
msgid "Done. Deleted 1 file and freed {size}. Sizes come back as pages use them."
msgstr "Klaar. 1 bestand verwijderd, {size} vrijgemaakt. Formaten komen terug zodra pagina’s ze gebruiken."

#: src/Admin.php:103
msgid "Deletes the sizes WordPress made at upload and the files of sizes that no longer exist. Sizes pages use come back on their next request."
msgstr "Verwijdert de formaten die WordPress bij het uploaden maakte, en bestanden van formaten die niet meer bestaan. Formaten die pagina’s gebruiken komen bij het volgende verzoek terug."

#: src/Admin.php:509
msgid "{count} are animated and stay as they are, so they keep moving."
msgstr "{count} zijn geanimeerd en blijven zoals ze zijn, zodat ze blijven bewegen."

#: src/Admin.php:344
msgid "In-between width"
msgstr "Tussenbreedte"
